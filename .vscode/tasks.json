{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cmake",
      "label": "CMake: build DvmEngine",
      "command": "build",
      "targets": [
        "DvmEngine"
      ],
      "preset": "${command:cmake.activeBuildPresetName}",
      "group": "build",
      "detail": "Task generated by Debugger."
    },
    {
      "label": "Build Windows",
      "command": "${workspaceFolder}/build.bat",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "Clean build",
      "command": "${workspaceFolder}/clean-build.bat",
      "group": {
        "kind": "build"
      },
      "problemMatcher": [],
      "detail": "CMake template build task"
    },
    {
      "type": "cmake",
      "label": "CMake: build",
      "command": "build",
      "targets": [
        "all"
      ],
      "group": "build",
      "problemMatcher": [],
      "detail": "CMake template build task"
    }
  ]
}